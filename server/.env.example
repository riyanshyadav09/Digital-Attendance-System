PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/face_attendance
JWT_SECRET=replace-with-a-long-random-secret
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
FACE_SERVICE_TIMEOUT_MS=120000
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

CAMPUS_LATITUDE=0
CAMPUS_LONGITUDE=0
CAMPUS_RADIUS=150

# Optional for application startup. Configure all of these to enable
# email-based forgot-password OTP. If omitted or incomplete, password reset
# returns HTTP 503 while login, attendance, and face recognition remain active.
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

ADMIN_NAME=Admin
ADMIN_EMAIL=replace-with-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-password
